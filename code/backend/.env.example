# Copy to .env for local development.

# PostgreSQL connection string used by app/database.py.
DATABASE_URL=postgresql+psycopg2://devproof:devproof@localhost:5432/devproof

# Optional: raises the GitHub REST API rate limit from 60/hr to 5000/hr.
# Create a classic token with no scopes (public data only) at
# https://github.com/settings/tokens.
GITHUB_TOKEN=

# Google OAuth Client ID (Web application type) from Google Cloud
# Console - must match the frontend's VITE_GOOGLE_CLIENT_ID. See
# README.md "Google sign-in setup" for how to create one.
GOOGLE_CLIENT_ID=

# Secret used to sign DevProof's own session JWTs (issued after a
# Google sign-in succeeds). Any long random string; generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=dev-only-insecure-secret-change-me
