# Copy to .env for local development.

# Must match the backend's GOOGLE_CLIENT_ID exactly - see
# code/backend/.env.example and README.md "Google sign-in setup".
VITE_GOOGLE_CLIENT_ID=

# Only needed if the backend isn't running at the default localhost:8000.
# On Vercel, set it to the Render backend's address, e.g.
# https://devproof-api.onrender.com (no trailing slash).
# VITE_API_BASE=http://127.0.0.1:8000
